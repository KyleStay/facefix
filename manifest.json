{
  "manifest_version": 3,
  "name": "Facefix \u2014 Keep My Place",
  "version": "1.4.2",
  "minimum_chrome_version": "111",
  "description": "Reduce Facebook return-to-tab refreshes, Home redirects, and scroll jumps.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Facefix",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "settings.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
